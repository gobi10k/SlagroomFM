[Unit]
Description=SlagroomFM Radio Scheduler
After=network.target

[Service]
Type=simple
User=alec
WorkingDirectory=/srv/app/radio/scheduler
EnvironmentFile=/etc/slagroomfm/radio.env
ExecStart=/srv/app/.venv-radio/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
